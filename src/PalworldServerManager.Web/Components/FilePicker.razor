@using PalworldServerManager.Core.FileSystem
@inject IFileSystemBrowser FileSystemBrowser

<div class="folder-browser">
    <div class="folder-browser-path">
        <button type="button" class="btn-link" disabled="@(_parentPath is null)" @onclick="GoUp" title="Up one level">⬆</button>
        <span class="folder-browser-current-path">@_currentPath</span>
    </div>

    @if (_currentDirectories.Count == 0 && _currentFiles.Count == 0)
    {
        <p class="folder-browser-empty">Nothing here.</p>
    }
    else
    {
        <ul class="folder-browser-list">
            @foreach (var entry in _currentDirectories)
            {
                <li>
                    <button type="button" class="btn-link" @onclick="() => NavigateTo(entry.FullPath)">📁 @entry.Name</button>
                </li>
            }
            @foreach (var entry in _currentFiles)
            {
                <li>
                    <button type="button" class="btn-link file-picker-file" @onclick="() => Select(entry.FullPath)">📄 @entry.Name</button>
                </li>
            }
        </ul>
    }

    <div class="folder-browser-actions">
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </div>
</div>

@code {
    [Parameter] public string? StartPath { get; set; }
    [Parameter] public string SearchPattern { get; set; } = "*.zip";
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _currentPath = string.Empty;
    private string? _parentPath;
    private IReadOnlyList<DirectoryEntry> _currentDirectories = [];
    private IReadOnlyList<DirectoryEntry> _currentFiles = [];

    protected override void OnInitialized()
    {
        var start = !string.IsNullOrWhiteSpace(StartPath) && Directory.Exists(StartPath)
            ? StartPath!
            : null;

        if (start is not null)
        {
            NavigateTo(start);
        }
        else
        {
            ShowRoots();
        }
    }

    private void ShowRoots()
    {
        _currentPath = string.Empty;
        _parentPath = null;
        _currentDirectories = FileSystemBrowser.GetRoots();
        _currentFiles = [];
    }

    private void NavigateTo(string path)
    {
        _currentPath = path;
        _parentPath = FileSystemBrowser.GetParent(path);
        _currentDirectories = FileSystemBrowser.GetSubdirectories(path);
        _currentFiles = FileSystemBrowser.GetFiles(path, SearchPattern);
    }

    private void GoUp()
    {
        if (_parentPath is not null)
        {
            NavigateTo(_parentPath);
        }
        else
        {
            ShowRoots();
        }
    }

    private Task Select(string filePath) => OnSelect.InvokeAsync(filePath);

    private Task Cancel() => OnCancel.InvokeAsync();
}
