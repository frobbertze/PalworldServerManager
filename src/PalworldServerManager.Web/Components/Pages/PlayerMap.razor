@page "/map"
@using System.Globalization
@using PalworldServerManager.Core.Configuration
@using PalworldServerManager.Core.Map
@using PalworldServerManager.Core.RestApi
@using PalworldServerManager.Core.Settings
@implements IDisposable
@inject IAppConfigService AppConfigService
@rendermode InteractiveServer

<PageTitle>Live Map</PageTitle>

<h1>Live Map</h1>

@if (_installPath is null)
{
    <p>No server install folder is configured yet. <a href="/setup">Go to Setup</a> first.</p>
}
else if (_loadError is not null)
{
    <p class="setup-status setup-status-error">@_loadError</p>
}
else
{
    @if (_restInfo is not { Enabled: true })
    {
        <p class="setup-status setup-status-warn">
            The REST API is disabled for this server. Enable <strong>REST API Enabled</strong> under
            <a href="/server-settings">Server Settings</a> (Advanced table — <code>RESTAPIEnabled</code>),
            then restart the server, to see live player positions.
        </p>
    }
    else if (_errorMessage is not null)
    {
        <p class="setup-status setup-status-error">@_errorMessage</p>
    }

    <p class="setting-field-description">
        Player positions update every 5 seconds. Marker positions are calibrated to the bundled map
        image — if they look off, check the coordinate transform in <code>PalworldMapCoordinateTransform</code>.
        Resource node locations are static community data, not live-tracked.
    </p>

    <div class="map-layer-toggles">
        @foreach (var type in ResourceLayerTypes)
        {
            <label class="map-layer-toggle">
                <input type="checkbox" checked="@_visibleLayers.Contains(type)" @onchange="e => ToggleLayer(type, e.Value)" />
                <span class="map-layer-swatch" style="background: @ResourceColor(type);"></span>
                @type
            </label>
        }
    </div>

    <div class="palworld-map-container">
        <img src="images/palworld-map.jpg" alt="Palworld world map" class="palworld-map-image" />

        @foreach (var node in ResourceNodeData.All)
        {
            @if (_visibleLayers.Contains(node.Type))
            {
                var (percentX, percentY) = PalworldMapCoordinateTransform.ToMapPercentFromPin(node.LocX, node.LocY);
                <div class="palworld-map-resource-dot" style="left: @(percentX.ToString("F2", CultureInfo.InvariantCulture))%; top: @(percentY.ToString("F2", CultureInfo.InvariantCulture))%; background: @ResourceColor(node.Type);" title="@node.Type"></div>
            }
        }

        @if (_players is not null)
        {
            @foreach (var player in _players)
            {
                var (percentX, percentY) = PalworldMapCoordinateTransform.ToMapPercent(player.LocationX, player.LocationY);
                <div class="palworld-map-dot" style="left: @(percentX.ToString("F2", CultureInfo.InvariantCulture))%; top: @(percentY.ToString("F2", CultureInfo.InvariantCulture))%;" title="@player.Name (Lv. @player.Level)">
                    <span class="palworld-map-dot-label">@player.Name</span>
                </div>
            }
        }
    </div>
}

@code {
    private static readonly ResourceType[] ResourceLayerTypes = Enum.GetValues<ResourceType>();

    private string? _installPath;
    private RestApiConnectionInfo? _restInfo;
    private string? _loadError;
    private string? _errorMessage;
    private IReadOnlyList<PalworldRestPlayer>? _players;
    private Timer? _pollTimer;
    private readonly HashSet<ResourceType> _visibleLayers = [.. Enum.GetValues<ResourceType>()];

    protected override async Task OnInitializedAsync()
    {
        _installPath = AppConfigService.Current.ServerInstallPath;
        if (string.IsNullOrWhiteSpace(_installPath))
        {
            _installPath = null;
            return;
        }

        await LoadConnectionInfoAsync();

        if (_restInfo is { Enabled: true })
        {
            await RefreshPlayersAsync();
            _pollTimer = new Timer(async _ => await InvokeAsync(async () =>
            {
                await RefreshPlayersAsync();
                StateHasChanged();
            }), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
    }

    private async Task LoadConnectionInfoAsync()
    {
        if (_installPath is null)
        {
            return;
        }

        if (!PalWorldSettingsFile.Exists(_installPath))
        {
            _loadError = "No PalWorldSettings.ini found. Has the server been run at least once?";
            return;
        }

        try
        {
            var settings = await PalWorldSettingsFile.LoadAsync(_installPath);
            _restInfo = RestApiConnectionInfo.FromSettings(settings);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to read settings: {ex.Message}";
        }
    }

    private async Task RefreshPlayersAsync()
    {
        if (_restInfo is not { Enabled: true } info)
        {
            return;
        }

        try
        {
            using var rest = new PalworldRestApiClient(info.Host, info.Port, info.Password);
            _players = await rest.GetPlayersAsync();
            _errorMessage = null;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not refresh players: {ex.Message}";
        }
    }

    private void ToggleLayer(ResourceType type, object? isChecked)
    {
        if (isChecked is true)
        {
            _visibleLayers.Add(type);
        }
        else
        {
            _visibleLayers.Remove(type);
        }
    }

    private static string ResourceColor(ResourceType type) => type switch
    {
        ResourceType.Coal => "#2d3748",
        ResourceType.Metal => "#a0aec0",
        ResourceType.Quartz => "#9f7aea",
        ResourceType.Sulfur => "#ecc94b",
        _ => "#718096",
    };

    public void Dispose() => _pollTimer?.Dispose();
}
